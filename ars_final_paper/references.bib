@article{10.1093/comjnl/5.1.10,
  title = {Quicksort},
  author = {Hoare, C. A. R.},
  year = 1962,
  month = jan,
  journal = {The Computer Journal},
  volume = {5},
  number = {1},
  eprint = {https://academic.oup.com/comjnl/article-pdf/5/1/10/1111445/050010.pdf},
  pages = {10--16},
  issn = {0010-4620},
